#include "xparameters.h"
#include "xiic.h"
#include "xil_printf.h"
#include "sleep.h"

#define IIC_DEVICE_ID XPAR_IIC_0_DEVICE_ID
#define TMP3_ADDR 0x48

XIic Iic;

int main()
{
    u8 buf[2];
    int status;

    xil_printf("TMP3 via AXI IIC\r\n");

    status = XIic_Initialize(&Iic, IIC_DEVICE_ID);
    if (status != XST_SUCCESS) {
        xil_printf("IIC init failed\r\n");
        return -1;
    }

    XIic_Start(&Iic);

    while (1) {
        status = XIic_Recv(Iic.BaseAddress, TMP3_ADDR, buf, 2, XIIC_STOP);
        if (status == 2) {
            int raw = (buf[0] << 4) | (buf[1] >> 4);
            float temp = raw * 0.0625;
            xil_printf("Temp: %d.%02d C\r\n",
                       (int)temp,
                       (int)((temp - (int)temp) * 100));
        }
        sleep(1);
    }
}
