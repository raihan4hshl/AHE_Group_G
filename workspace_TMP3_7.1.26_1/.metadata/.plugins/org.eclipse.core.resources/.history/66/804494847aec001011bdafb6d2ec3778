/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */

#include <stdio.h>
#include "xparameters.h"
#include "xil_printf.h"
#include "sleep.h"
#include "PmodTMP3.h"

// Instance of the TMP3 Driver
PmodTMP3 myTMP3;

int main() {
    float temp_c, temp_f;
    int count = 0;

    // 1. Initialize the PmodTMP3 Device
    // Use the Base Address defined in your xparameters.h (from the Vivado design)
    // The name should match your IP block name: XPAR_PMODTMP3_0_AXI_LITE_SPI_BASEADDR
    TMP3_begin(&myTMP3, XPAR_PMODTMP3_0_AXI_LITE_IIC_BASEADDR 0x00020000);

    xil_printf("\r\n--- Car Seat Temperature Sensor System ---\r\n");
    xil_printf("Consultant Note: Real-time monitoring active.\r\n");

    while (1) {
        // 2. Read temperature from the sensor via I2C/SPI bridge
        temp_c = TMP3_getTemperature(&myTMP3);

        // 3. Convert Celsius to Fahrenheit
        temp_f = (temp_c * 9.0 / 5.0) + 32.0;

        // 4. Output to UART
        // Note: xil_printf does not support floating point (%f) by default in some versions.
        // We cast to int for safe printing if needed, or use printf.
        printf("[%d] Seat Temp: %.2f C | %.2f F\r\n", count++, temp_c, temp_f);

        // 5. Sampling Rate (Standard for automotive thermal monitoring is 1Hz)
        sleep(1);
    }

    return 0;
}
